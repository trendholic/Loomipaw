# =====================================================================
# Loomipaw environment configuration
# Copy to `.env` and fill in. Everything works out-of-the-box with the
# development defaults below — no third-party credentials required to run.
# =====================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Public base URL (used in emails, links). No trailing slash.
APP_URL=http://localhost:4000

# --- Security ---
# CHANGE THESE in production. Long random strings.
JWT_SECRET=dev-change-me-to-a-long-random-secret
SESSION_COOKIE=lp_session
# Comma-separated allowed origins for CORS (blank = same-origin only)
CORS_ORIGINS=

# --- Store defaults (also editable at runtime in Admin → Settings) ---
STORE_NAME=Loomipaw
STORE_CURRENCY=USD
STORE_EMAIL=hello@loomipaw.com

# --- Payments ---
# Provider: "dev" (simulated) | "stripe" | "paypal"
PAYMENT_PROVIDER=dev
# Required only when PAYMENT_PROVIDER=stripe. Add your keys here later.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal (Orders v2). Required only when PAYMENT_PROVIDER=paypal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- Email ---
# Transport: "dev" (writes .eml files to var/mail) | "smtp"
MAIL_TRANSPORT=dev
MAIL_FROM="Loomipaw <hello@loomipaw.com>"
# Required only when MAIL_TRANSPORT=smtp. Add your provider details later.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Admin bootstrap (used by `npm run seed`) ---
ADMIN_EMAIL=admin@loomipaw.com
ADMIN_PASSWORD=Admin123!change
