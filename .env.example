# =====================================================================
# Loomipaw environment configuration
# Copy to `.env` and fill in. Everything works out-of-the-box with the
# development defaults below — no third-party credentials required to run.
#
# ┌───────────────────────────────────────────────────────────────────┐
# │ PRODUCTION MUST-SET (the app refuses to boot in production without   │
# │ these, or warns loudly — see server/lib/validateEnv.js):            │
# │   NODE_ENV=production                                                │
# │   APP_URL=https://your-domain.com                                    │
# │   JWT_SECRET      → openssl rand -base64 48                          │
# │   ADMIN_PASSWORD  → a strong, unique password (not the default)      │
# │   PAYMENT_PROVIDER=stripe|paypal  (+ that provider's keys)           │
# │   MAIL_TRANSPORT=smtp  (+ SMTP_* )  for real email delivery          │
# └───────────────────────────────────────────────────────────────────┘
# =====================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Public base URL (used in emails, links, sitemap, SEO). No trailing slash.
# In production this MUST be your public https:// URL.
APP_URL=http://localhost:4000

# --- Security ---
# JWT_SECRET signs sessions. In production it MUST be long & random.
#   Generate: openssl rand -base64 48
JWT_SECRET=dev-change-me-to-a-long-random-secret
SESSION_COOKIE=lp_session
# Comma-separated allowed origins for CORS (blank = same-origin only)
CORS_ORIGINS=

# --- Store defaults (also editable at runtime in Admin → Settings) ---
STORE_NAME=Loomipaw
STORE_CURRENCY=USD
STORE_EMAIL=hello@loomipaw.com

# --- Payments ---
# Provider: "dev" (simulated — NEVER for real customers) | "stripe" | "paypal"
PAYMENT_PROVIDER=dev
# Stripe — required when PAYMENT_PROVIDER=stripe. Also run: npm install stripe
#   Use sk_live_… in production; set the webhook secret for async confirmation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# PayPal (Orders v2) — required when PAYMENT_PROVIDER=paypal.
#   Set PAYPAL_ENV=live in production; set the webhook id for verification.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- Email ---
# Transport: "dev" (writes .eml files to var/mail, no delivery) | "smtp"
# Works with any SMTP provider: SendGrid, Postmark, Amazon SES, Mailgun, …
MAIL_TRANSPORT=dev
MAIL_FROM="Loomipaw <hello@loomipaw.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Admin bootstrap (used by `npm run seed`) ---
ADMIN_EMAIL=admin@loomipaw.com
# CHANGE THIS before production — the app blocks prod boot on the default.
ADMIN_PASSWORD=Admin123!change

# --- Backups (scripts/backup.js; see DISASTER_RECOVERY.md) ---
# Where snapshots are written, and how many to retain.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- Marketing / analytics tags (all optional) ---
# Each is loaded only when set; leaving it blank installs nothing and keeps
# the Content-Security-Policy locked down. See CONVERSION_OPTIMIZATION_REPORT.md.
GA4_MEASUREMENT_ID=        # Google Analytics 4, e.g. G-XXXXXXXXXX
META_PIXEL_ID=             # Meta (Facebook/Instagram) Pixel, e.g. 1234567890
TIKTOK_PIXEL_ID=           # TikTok Pixel, e.g. C9XXXXXXXXXXXXXXXX
CLARITY_PROJECT_ID=        # Microsoft Clarity project id, e.g. abcdef1234
# Google Search Console: verify via the Google Analytics method (uses GA4 above)
# or a DNS TXT record — no HTML change required.
