{
  "name": "loomipaw",
  "version": "1.0.0",
  "private": true,
  "description": "Loomipaw \u2014 standalone premium pet lifestyle eCommerce platform (Node.js + Express + SQLite).",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "node server/db/migrate.js && node server/db/seed.js",
    "test:api": "node server/test/e2e.js",
    "test": "node --test server/test/unit.test.js server/test/security.test.js server/test/flow.test.js",
    "test:unit": "node --test server/test/unit.test.js",
    "test:security": "node --test server/test/security.test.js",
    "test:flow": "node --test server/test/flow.test.js",
    "coverage": "c8 --reporter=text --reporter=text-summary --reporter=html --reporter=lcov node --test server/test/unit.test.js server/test/security.test.js server/test/flow.test.js",
    "coverage:check": "c8 --check-coverage node --test server/test/unit.test.js server/test/security.test.js server/test/flow.test.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^9.0.3",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
