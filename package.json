{
  "name": "loomipaw",
  "version": "1.0.0",
  "private": true,
  "description": "Loomipaw — standalone premium pet lifestyle eCommerce platform (Node.js + Express + SQLite).",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "node server/db/migrate.js && node server/db/seed.js",
    "test:api": "node server/test/e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^9.0.3",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
